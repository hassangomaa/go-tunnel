# go-tunnel server (board + relay)
PORT=4055
LIST_LIMIT=200
DATA_DIR=/opt/go-tunnel/data
SQLITE_PATH=/opt/go-tunnel/data/visits.db
PAYLOAD_PATH=/probe
PUBLIC_URL=https://go.tejarahlntpoor.com
TARGET_URL=http://127.0.0.1:3000
REQUEST_TIMEOUT_MS=30000
# Visitor geo / IP intelligence (ngrok-style). Set GEO_LOOKUP=0 to disable.
GEO_LOOKUP=1
GEO_CACHE_TTL_MS=21600000
GEO_LOOKUP_TIMEOUT_MS=2500
# SERVER_REGION=me-east-1

# go-tunnel-client (VPS forward agent)
GO_WS=wss://go.tejarahlntpoor.com/ws
# TARGET_URL=http://127.0.0.1:3000
# ECHO=1   # only if TARGET_URL empty — debug echo mode
